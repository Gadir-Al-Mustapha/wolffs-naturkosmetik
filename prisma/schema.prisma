generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                Int          @id @default(autoincrement())
  name              String
  standardPriceCent Int
  recipe            Ingredient[] @relation("BaseRecipe")
  batches           Batch[]
}

model Ingredient {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  isAllergen   Boolean
  note         String?
  products     Product[]         @relation("BaseRecipe")
  batchEntries BatchIngredient[]
}

model Batch {
  id             Int               @id @default(autoincrement())
  productId      Int
  product        Product           @relation(fields: [productId], references: [id])
  manufacturedOn String
  bestBefore     String
  quantity       Int
  ingredients    BatchIngredient[]

  @@index([productId, bestBefore])
}

model BatchIngredient {
  batchId      Int
  batch        Batch      @relation(fields: [batchId], references: [id])
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  name         String
  isAllergen   Boolean
  note         String?

  @@id([batchId, ingredientId])
}
