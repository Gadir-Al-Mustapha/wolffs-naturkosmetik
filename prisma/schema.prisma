generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                Int          @id @default(autoincrement())
  name              String
  standardPriceCent Int
  recipe            Ingredient[] @relation("BaseRecipe")
  batches           Batch[]
  orderLines        OrderLine[]
  monthlyBoxes      MonthlyBox[]
  fairRequests      FairRequest[]
}

model Ingredient {
  id           Int               @id @default(autoincrement())
  name         String            @unique
  isAllergen   Boolean
  note         String?
  products     Product[]         @relation("BaseRecipe")
  batchEntries BatchIngredient[]
}

model Batch {
  id             Int               @id @default(autoincrement())
  productId      Int
  product        Product           @relation(fields: [productId], references: [id])
  manufacturedOn String
  bestBefore     String
  quantity       Int
  ingredients    BatchIngredient[]
  allocations    Allocation[]
  fairStock      FairStock[]

  @@index([productId, bestBefore])
}

model BatchIngredient {
  batchId      Int
  batch        Batch      @relation(fields: [batchId], references: [id])
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  name         String
  isAllergen   Boolean
  note         String?

  @@id([batchId, ingredientId])
}

model Customer {
  id     Int            @id @default(autoincrement())
  name   String
  loyal  Boolean
  partnerDiscountPercent Int?
  orders PrivateOrder[]
  monthlyBoxes MonthlyBox[]
}

model Promotion {
  code       String  @id
  percent    Int
  combinable Boolean
}

model PrivateOrder {
  id                Int               @id @default(autoincrement())
  customerId        Int
  customer          Customer          @relation(fields: [customerId], references: [id])
  token             String            @unique
  createdAt         DateTime          @default(now())
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  reminder          TestPaymentReminder?
  delivery          String
  loyal             Boolean
  code              String?
  subtotal          Int
  loyaltyDiscount   Int
  promotionDiscount Int
  promotionExcluded Boolean @default(false)
  shipping          Int
  total             Int
  lines             OrderLine[]
  message           TestConfirmation?
  partnerDiscountPercent Int?
  partnerPriceApplied Boolean @default(false)
  partnerExceptionReason String?
  payment Payment?
  labelReadyAt DateTime?
  packedAt DateTime?
  bicycleStartedAt DateTime?
  handedOffAt DateTime?
  pickupOn String?
  trackingNumber String?
  monthlyBoxRun MonthlyBoxRun?
}

model OrderLine {
  id          Int          @id @default(autoincrement())
  orderId     Int
  order       PrivateOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Int
  allocations Allocation[]
}

model Allocation {
  lineId      Int
  line        OrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batchId     Int
  batch       Batch     @relation(fields: [batchId], references: [id])
  quantity    Int
  ingredients Json
  confirmedAt DateTime?

  @@id([lineId, batchId])
  @@index([batchId])
}

model TestConfirmation {
  orderId   Int          @id
  order     PrivateOrder @relation(fields: [orderId], references: [id])
  body      String
  createdAt DateTime     @default(now())
}

model Payment {
  orderId Int @id
  order PrivateOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method String
  status String
  dueOn String?
  paidAt DateTime?
}

model TestPaymentReminder {
  orderId   Int          @id
  order     PrivateOrder @relation(fields: [orderId], references: [id])
  body      String
  createdAt DateTime     @default(now())
}

model MonthlyBox {
  id              Int       @id @default(autoincrement())
  customerId      Int
  customer        Customer  @relation(fields: [customerId], references: [id])
  products        Product[]
  inviteToken     String    @unique
  managementToken String    @unique
  priceCent       Int
  activatedAt     DateTime?
  pauses          MonthlyBoxPause[]
  runs            MonthlyBoxRun[]
}

model MonthlyBoxPause {
  boxId      Int
  box        MonthlyBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  startMonth Int
  endMonth   Int
  resumedAt  DateTime?

  id Int @id @default(autoincrement())

  @@index([boxId, startMonth])
}

model MonthlyBoxRun {
  boxId         Int
  box           MonthlyBox    @relation(fields: [boxId], references: [id])
  month         Int
  orderId       Int?          @unique
  order         PrivateOrder? @relation(fields: [orderId], references: [id])
  failureReason String?
  creditCent    Int           @default(0)
  appliedCent   Int           @default(0)

  @@id([boxId, month])
}

model Fair {
  id          Int           @id @default(autoincrement())
  name        String
  eventDate   String
  dispatchedAt DateTime?
  closedAt     DateTime?
  requests    FairRequest[]
  stock       FairStock[]
}

model FairRequest {
  fairId    Int
  fair      Fair    @relation(fields: [fairId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@id([fairId, productId])
}

model FairStock {
  fairId   Int
  fair     Fair     @relation(fields: [fairId], references: [id])
  batchId  Int
  batch    Batch    @relation(fields: [batchId], references: [id])
  taken    Int
  returned Int?

  @@id([fairId, batchId])
}
